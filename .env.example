# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real secrets.

# Server-side only. Never referenced from client components.
OPENAI_API_KEY=

DATABASE_URL="file:./dev.db"

# Where authenticated Playwright browser sessions are stored, one
# sub-folder per channel/account. Safe to change, must stay out of git.
PLAYWRIGHT_PROFILES_DIR=./playwright-profiles

# Where automation screenshots are written for the "View Logs" screen.
SCREENSHOTS_DIR=./storage/screenshots

# Default number of Playwright jobs allowed to run at the same time.
DEFAULT_CONCURRENCY=2
